---
interface Props {
  type: 'track' | 'album';
  id: string;
  label?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { type, id, label, ctaLabel, ctaHref } = Astro.props;
const src = `https://open.spotify.com/embed/${type}/${id}`;
---

<div class="hog-card w-full">
  {
    (label || (ctaLabel && ctaHref)) && (
      <div class="mb-3 flex items-center justify-between gap-4">
        {label && <p class="font-display text-hog-goldBright">{label}</p>}
        {ctaLabel && ctaHref && (
          <a
            href={ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="hog-focus-ring shrink-0 py-1.5 font-body text-sm font-semibold text-hog-gold underline decoration-hog-gold/60 underline-offset-4 hover:text-hog-goldBright"
          >
            {ctaLabel}
          </a>
        )}
      </div>
    )
  }
  <iframe
    class="rounded-lg"
    style="border-radius:12px"
    src={src}
    width="100%"
    height={type === 'album' ? 352 : 152}
    frameborder="0"
    allowfullscreen
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
    title={label ?? `Spotify ${type} embed`}
  ></iframe>
</div>
