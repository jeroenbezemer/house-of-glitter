---
import type { Locale } from '../i18n/routes';
import { EMAIL, SPOTIFY_ARTIST_URL } from '../data/socials';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const rightsText = lang === 'nl' ? 'Alle rechten voorbehouden.' : 'All rights reserved.';
const instagramTitle = lang === 'nl' ? 'Binnenkort beschikbaar' : 'Coming soon';

// Instagram has no href yet: omit it until the account is live.
const socialLinks = [
  { label: 'Spotify', href: SPOTIFY_ARTIST_URL, external: true },
  { label: 'Instagram', href: undefined, title: instagramTitle },
  { label: lang === 'nl' ? 'E-mail' : 'Email', href: `mailto:${EMAIL}` },
];
---

<footer class="border-t border-hog-gold/40 bg-hog-purple">
  <div class="hog-rainbow-divider"></div>
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-3 px-4 py-8 text-sm text-hog-text/80 sm:flex-row sm:justify-between">
    <p class="font-display text-hog-gold">&copy; {year} House of Glitter. {rightsText}</p>
    <ul class="flex gap-5">
      {
        socialLinks.map((link) =>
          link.href ? (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="hog-focus-ring text-hog-gold hover:text-hog-goldBright"
              >
                {link.label}
              </a>
            </li>
          ) : (
            <li>
              <span title={link.title} class="cursor-default text-hog-text/65">
                {link.label}
              </span>
            </li>
          )
        )
      }
    </ul>
  </div>
</footer>
