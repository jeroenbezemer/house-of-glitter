---
const year = new Date().getFullYear();

// TODO: vervang placeholder social links door de echte URL's zodra die bekend zijn
const socialLinks = [
  { label: 'Spotify', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'E-mail', href: 'mailto:info@example.com' },
];
---

<footer class="border-t border-hog-gold/40 bg-hog-purple">
  <div class="hog-rainbow-divider"></div>
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-3 px-4 py-8 text-sm text-hog-text/80 sm:flex-row sm:justify-between">
    <p class="font-display text-hog-gold">&copy; {year} House of Glitter. Alle rechten voorbehouden.</p>
    <ul class="flex gap-5">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} class="text-hog-gold hover:text-hog-goldBright">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
