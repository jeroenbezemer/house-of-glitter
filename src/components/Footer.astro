---
const year = new Date().getFullYear();

// TODO: vervang placeholder social links door de echte URL's zodra die bekend zijn
const socialLinks = [
  { label: 'Spotify', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'E-mail', href: 'mailto:info@example.com' },
];
---

<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-3 px-4 py-8 text-sm text-gray-600 sm:flex-row sm:justify-between">
    <p>&copy; {year} House of Glitter. Alle rechten voorbehouden.</p>
    <ul class="flex gap-4">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:underline">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
