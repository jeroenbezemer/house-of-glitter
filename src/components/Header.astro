---
import { routes, type PageKey, type Locale } from '../i18n/routes';

interface Props {
  lang: Locale;
  page: PageKey;
}

const { lang, page } = Astro.props;

const labels: Record<Locale, Record<PageKey, string>> = {
  en: { home: 'Home', music: 'Music', story: 'Story', shop: 'Shop', contact: 'Contact' },
  nl: { home: 'Home', music: 'Muziek', story: 'Verhaal', shop: 'Shop', contact: 'Contact' },
};

const pageKeys: PageKey[] = ['home', 'music', 'story', 'shop', 'contact'];

const navItems = pageKeys.map((key) => ({
  key,
  href: routes[key][lang],
  label: labels[lang][key],
}));

const homeHref = routes.home[lang];
const menuLabel = lang === 'nl' ? 'Menu openen' : 'Open menu';
---

<header class="sticky top-0 z-50 border-b border-hog-gold/40 bg-hog-purple/95 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <a href={homeHref} class="hog-focus-ring font-display text-xl font-semibold text-hog-gold hover:text-hog-goldBright">
      House of Glitter
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-6 md:flex">
      <ul class="flex gap-8 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'hog-nav-link hog-focus-ring relative pb-1 text-hog-text hover:text-hog-goldBright',
                  { 'text-hog-goldBright hog-nav-link--active': item.key === page },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Language switcher -->
      <div class="flex items-center gap-1.5 border-l border-hog-gold/30 pl-6 text-xs font-semibold tracking-wide">
        <a
          href={routes[page].en}
          aria-label="English"
          aria-current={lang === 'en' ? 'true' : undefined}
          class:list={[
            'hog-focus-ring transition-colors',
            lang === 'en' ? 'text-hog-gold' : 'text-hog-text/65 hover:text-hog-goldBright',
          ]}
        >
          EN
        </a>
        <span class="text-hog-text/30">/</span>
        <a
          href={routes[page].nl}
          aria-label="Nederlands"
          aria-current={lang === 'nl' ? 'true' : undefined}
          class:list={[
            'hog-focus-ring transition-colors',
            lang === 'nl' ? 'text-hog-gold' : 'text-hog-text/65 hover:text-hog-goldBright',
          ]}
        >
          NL
        </a>
      </div>
    </div>

    <!-- Hamburger button (mobile only) -->
    <button
      id="hog-menu-toggle"
      type="button"
      class="hog-focus-ring flex h-9 w-9 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-controls="hog-mobile-menu"
      aria-expanded="false"
      aria-label={menuLabel}
    >
      <span class="h-0.5 w-6 rounded bg-hog-gold transition-transform"></span>
      <span class="h-0.5 w-6 rounded bg-hog-gold transition-opacity"></span>
      <span class="h-0.5 w-6 rounded bg-hog-gold transition-transform"></span>
    </button>
  </nav>

  <!-- Mobile nav panel -->
  <ul
    id="hog-mobile-menu"
    class="hidden flex-col gap-1 border-t border-hog-gold/30 px-4 pb-4 pt-2 md:hidden"
  >
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'hog-focus-ring block px-2 py-2 text-hog-text hover:text-hog-goldBright',
              { 'text-hog-goldBright underline decoration-hog-gold underline-offset-4': item.key === page },
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
    <li class="mt-2 flex items-center gap-2 border-t border-hog-gold/20 px-2 pt-3 text-xs font-semibold tracking-wide">
      <a
        href={routes[page].en}
        aria-label="English"
        aria-current={lang === 'en' ? 'true' : undefined}
        class:list={['hog-focus-ring', lang === 'en' ? 'text-hog-gold' : 'text-hog-text/65 hover:text-hog-goldBright']}
      >
        EN
      </a>
      <span class="text-hog-text/30">/</span>
      <a
        href={routes[page].nl}
        aria-label="Nederlands"
        aria-current={lang === 'nl' ? 'true' : undefined}
        class:list={['hog-focus-ring', lang === 'nl' ? 'text-hog-gold' : 'text-hog-text/65 hover:text-hog-goldBright']}
      >
        NL
      </a>
    </li>
  </ul>
</header>

<style>
  /* Gouden onderstreping bij hover en op de actieve pagina */
  .hog-nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: theme('colors.hog.gold');
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .hog-nav-link:hover::after,
  .hog-nav-link--active::after {
    transform: scaleX(1);
  }
</style>

<script>
  const toggle = document.getElementById('hog-menu-toggle');
  const menu = document.getElementById('hog-mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
