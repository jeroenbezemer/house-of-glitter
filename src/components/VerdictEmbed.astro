---
interface Props {
  src: string;
  label?: string;
}

const { src, label } = Astro.props;
---

<div class="hog-card w-full">
  {label && <p class="mb-3 font-display text-hog-goldBright">{label}</p>}
  <iframe
    id="verdict-embed"
    class="rounded-lg"
    style="border-radius:12px; border:0"
    src={src}
    width="100%"
    height="600"
    loading="lazy"
    title="Stem mee"
  ></iframe>
</div>

<script>
  // Laat de iframe-hoogte meebewegen met de content van de ingesloten Verdict-pagina
  // (aantal inzendingen, in-/uitgeklapte tekst, wisselende stappen). Zie EMBEDDING.md
  // in de Verdict-repo voor de tegenhanger die deze berichten verstuurt.
  window.addEventListener('message', (event) => {
    const data = event.data;
    if (!data || data.source !== 'verdict-embed' || data.type !== 'resize') return;
    const iframe = document.getElementById('verdict-embed') as HTMLIFrameElement | null;
    if (iframe) {
      iframe.style.height = `${data.height}px`;
    }
  });
</script>
