---
import Layout from '../components/Layout.astro';

// TODO: hier wordt later een Fourthwall- of Shopify-shop geïntegreerd voor
// merchandise en releases.
---

<Layout title="House of Glitter — Shop">
  <h1 class="mb-6 text-3xl font-bold">Shop</h1>
  <div class="hog-card mx-auto max-w-2xl text-center font-body">
    <p class="text-hog-text/90">
      The merch line is on its way — think glitter, gold and everything House of
      Glitter stands for, wearable. Check back soon, or follow along on social
      media to be the first to know when it drops.
    </p>
  </div>
</Layout>
