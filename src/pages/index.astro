---
import Layout from '../components/Layout.astro';
---

<Layout title="House of Glitter — Home">
  <section class="flex flex-col items-center gap-6 py-8 text-center">
    <img
      src="/wapenschild.jpg"
      alt="Familiewapen House of Glitter"
      class="w-72 max-w-full rounded-lg drop-shadow-[0_0_35px_rgba(212,175,55,0.55)] sm:w-96"
    />
    <h1 class="text-4xl font-bold sm:text-5xl">House of Glitter</h1>
    <p class="font-display text-xl italic text-hog-goldBright sm:text-2xl">To Glitter or Die</p>
    <p class="max-w-xl font-body text-hog-text/90">
      Welcome to House of Glitter — a home for bold creativity and unapologetic
      self-expression. Wherever it shows up — sound, style, story — this is a place
      for bright colors, big personality and the confidence to own who you are.
      Step inside, and let your sparkle show.
    </p>
  </section>

  <div class="hog-rainbow-divider -mx-4 my-4 rounded-full sm:mx-0"></div>
</Layout>
