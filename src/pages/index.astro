---
import Layout from '../components/Layout.astro';
import { en } from '../i18n/en';
import { routes } from '../i18n/routes';
---

<Layout title="House of Glitter — Home" lang="en" page="home">
  <section class="flex flex-col items-center gap-6 py-8 text-center">
    <img
      src="/wapenschild.jpg"
      srcset="/wapenschild-384w.jpg 384w, /wapenschild.jpg 768w"
      sizes="(min-width: 640px) 384px, 288px"
      alt="House of Glitter family crest"
      width="768"
      height="1152"
      class="w-72 max-w-full rounded-lg drop-shadow-[0_0_35px_rgba(212,175,55,0.55)] sm:w-96"
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="text-4xl font-bold sm:text-5xl">House of Glitter</h1>
    <p class="font-display text-xl italic text-hog-goldBright sm:text-2xl">To Glitter or Die</p>
    <p class="max-w-xl font-body text-hog-text/90">{en.home.intro}</p>
    <p class="max-w-xl font-body text-hog-text/90">{en.home.announcement}</p>
    <a
      href={routes.music.en}
      class="hog-focus-ring rounded-full bg-hog-gold px-8 py-3 font-display font-semibold text-hog-purple transition hover:bg-hog-goldBright"
    >
      {en.home.cta}
    </a>
  </section>

  <div class="hog-rainbow-divider -mx-4 my-4 rounded-full sm:mx-0"></div>
</Layout>
