---
import Layout from '../../components/Layout.astro';
import SpotifyEmbed from '../../components/SpotifyEmbed.astro';
import TrackPreviewCard from '../../components/TrackPreviewCard.astro';
import { nl } from '../../i18n/nl';

// TODO: dit zijn tijdelijke Spotify-ID's. Vervang deze zodra de echte releases
// live staan.
const singleTrackId = '4hjOax118vWOwYnl5fAwXV';
---

<Layout title="House of Glitter — Muziek" lang="nl" page="music">
  <h1 class="mb-6 text-3xl font-bold">Muziek</h1>

  <div class="mb-10 max-w-2xl font-body">
    <p class="text-hog-text/90">{nl.music.description}</p>
  </div>

  <div class="flex flex-col gap-8">
    <!-- 1. Single: To Glitter or Die (Beach Club Anthem) — live op Spotify -->
    <div class="flex flex-col items-start gap-3">
      <SpotifyEmbed
        type="track"
        id={singleTrackId}
        label="To Glitter or Die (Beach Club Anthem)"
      />
      <a
        href={`https://open.spotify.com/track/${singleTrackId}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded px-1 font-body font-semibold text-hog-gold underline decoration-hog-gold/60 underline-offset-4 hover:text-hog-goldBright"
      >
        {nl.music.listenOnSpotify}
      </a>
    </div>

    <!-- TODO: AudioPreview-kaart wordt hier niet meer gerenderd nu de single
         live staat op Spotify. Referentie bewaard voor eventueel hergebruik
         bij een volgende nog-niet-uitgebrachte single.
    {(
      <TrackPreviewCard
        heading="To Glitter or Die (Beach Club Anthem)"
        badge={nl.music.comingSoon}
        artworkSrc="/images/covers/to-glitter-or-die-single.png"
        artworkAlt="Cover art — To Glitter or Die (Beach Club Anthem)"
        audioSrc="/audio/previews/to-glitter-or-die-beach-club-anthem-preview.mp3"
        trackName="To Glitter or Die (Beach Club Anthem)"
      />
    )}
    -->

    <!-- 2. Glitter Boy -->
    <TrackPreviewCard
      heading="Glitter Boy"
      badge={nl.music.comingSoon}
      audioSrc="/audio/previews/glitter-boy-preview.mp3"
      trackName="Glitter Boy"
      artworkAlt="Artwork — Glitter Boy (placeholder)"
    />

    <!-- 3. Estelle -->
    <TrackPreviewCard
      heading="Estelle"
      badge={nl.music.comingSoon}
      audioSrc="/audio/previews/estelle-preview.mp3"
      trackName="Estelle"
      artworkAlt="Artwork — Estelle (placeholder)"
    />

    <!-- TODO: Spotify-embeds terugzetten zodra de releases live staan —
         voorbeeld hieronder bewaard (niet gerenderd, alleen als referentie
         in de code). Zodra live: vervang de TrackPreviewCard's hierboven
         voor Glitter Boy en Estelle weer door deze SpotifyEmbed-aanroepen.
    {(
      <SpotifyEmbed
        type="track"
        id="697bFWgzBRm6bmnYWd8GyD"
        label="Glitter Boy — tijdelijke preview"
      />
    )}
    {(
      <SpotifyEmbed
        type="track"
        id="4VVfzoh8MuGWLIpcF8vB1O"
        label="Estelle — tijdelijke preview"
      />
    )}
    -->
  </div>

  <!-- 4. Full album, visueel gescheiden van de singles hierboven -->
  <div class="mt-14 border-t border-hog-gold/30 pt-10">
    <h2 class="mb-4 text-2xl font-bold">Full Album</h2>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
      <img
        src="/images/covers/to-glitter-or-die-album.png"
        alt="Albumhoes — To Glitter or Die"
        class="w-48 shrink-0 rounded-xl border border-hog-gold object-cover sm:w-56"
      />
      <div class="flex-1">
        <!-- TODO: dit is tijdelijke albuminhoud. Vervang door het echte album
             zodra dat gereleased is. -->
        <SpotifyEmbed
          type="album"
          id="7yY1t6U4nDXv5sG1LXnAol"
          label={nl.music.albumStatus}
        />
      </div>
    </div>
  </div>
</Layout>
