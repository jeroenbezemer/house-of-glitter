---
import Layout from '../../components/Layout.astro';
import { nl } from '../../i18n/nl';
import { EMAIL, SPOTIFY_ARTIST_URL } from '../../data/socials';

// TODO: Instagram-link wordt toegevoegd zodra het account live is.
---

<Layout title="House of Glitter — Contact" lang="nl" page="contact">
  <h1 class="mb-6 text-3xl font-bold">Contact</h1>
  <p class="mb-6 max-w-xl font-body text-hog-text/90">{nl.contact.intro}</p>
  <div class="hog-card">
    <ul class="flex flex-col gap-2 text-hog-text/90">
      <li>
        E-mail: <a href={`mailto:${EMAIL}`} class="hog-focus-ring text-hog-gold hover:text-hog-goldBright">{EMAIL}</a>
      </li>
      <li>Instagram: <span class="italic text-hog-text/65">{nl.contact.instagramComingSoon}</span></li>
      <li>
        Spotify:
        <a
          href={SPOTIFY_ARTIST_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hog-focus-ring text-hog-gold hover:text-hog-goldBright"
        >
          {nl.contact.spotifyCta}
        </a>
      </li>
    </ul>
  </div>
</Layout>
