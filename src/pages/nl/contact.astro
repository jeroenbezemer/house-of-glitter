---
import Layout from '../../components/Layout.astro';
import VerdictEmbed from '../../components/VerdictEmbed.astro';
import { nl } from '../../i18n/nl';

// TODO: e-mail, Instagram en Spotify-profiel-link worden aan het einde van de
// MVP (Fase 4) ingevuld met de echte gegevens.
const VERDICT_URL = 'https://verdict-feature-test-environment.up.railway.app/stem/combi-2-34ce36';
---

<Layout title="House of Glitter — Contact" lang="nl" page="contact">
  <h1 class="mb-6 text-3xl font-bold">Contact</h1>
  <p class="mb-6 max-w-xl font-body text-hog-text/90">{nl.contact.intro}</p>
  <div class="hog-card mb-6">
    <ul class="flex flex-col gap-2 text-hog-text/90">
      <li>E-mail: <span class="italic text-hog-text/50">TODO</span></li>
      <li>Instagram: <span class="italic text-hog-text/50">TODO</span></li>
      <li>Spotify: <span class="italic text-hog-text/50">TODO</span></li>
    </ul>
  </div>
  <VerdictEmbed src={VERDICT_URL} label={nl.contact.voteLabel} />
</Layout>
