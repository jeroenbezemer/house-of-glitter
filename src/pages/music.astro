---
import Layout from '../components/Layout.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';

// TODO: dit zijn tijdelijke Spotify-ID's. Vervang deze zodra de echte releases
// live staan.
---

<Layout title="House of Glitter — Muziek">
  <h1 class="mb-6 text-3xl font-bold">Muziek</h1>

  <div class="mb-10 max-w-2xl font-body">
    <p class="text-lg font-semibold text-hog-gold">Bright, bold and unapologetically pop.</p>
    <p class="mt-4 text-hog-text/90">
      Our music is a vibrant mix of contemporary pop, pop-rock and disco, with
      playful detours into unexpected sounds and influences. Think catchy hooks,
      energetic melodies, uplifting lyrics and a generous dose of glitter.
    </p>
    <p class="mt-4 text-hog-text/90">
      At the heart of it all is music that invites you to step into the light,
      embrace who you are and let yourself shine. Each song has its own
      personality — from rebellious pop-rock and feel-good disco to the occasional
      Balkan-inspired adventure — but they all share the same spirit: be bold, be
      bright, and let your sparkle show.
    </p>
  </div>

  <div class="flex flex-col gap-8">
    <!-- 1. Single: To Glitter or Die (Beach Club Anthem) -->
    <div>
      <div class="mb-4 flex flex-col items-start gap-3 sm:flex-row sm:items-end sm:gap-4">
        <!-- TODO: album cover wordt later toegevoegd door de gebruiker -->
        <div class="aspect-square w-32 shrink-0 rounded-lg border border-hog-gold bg-hog-purple sm:w-40"></div>
        <p class="font-display text-xs italic uppercase tracking-widest text-hog-gold">
          Out soon on Spotify
        </p>
      </div>
      <!-- TODO: tijdelijk dezelfde track-ID als "Glitter Boy" hergebruikt.
           Vervang door de echte track-ID van deze single zodra die live staat. -->
      <SpotifyEmbed
        type="track"
        id="697bFWgzBRm6bmnYWd8GyD"
        label="To Glitter or Die (Beach Club Anthem)"
      />
    </div>

    <!-- 2. Glitter Boy -->
    <SpotifyEmbed
      type="track"
      id="697bFWgzBRm6bmnYWd8GyD"
      label="Glitter Boy — tijdelijke preview"
    />

    <!-- 3. Estelle -->
    <SpotifyEmbed
      type="track"
      id="4VVfzoh8MuGWLIpcF8vB1O"
      label="Estelle — tijdelijke preview"
    />
  </div>

  <!-- 4. Full album, visueel gescheiden van de singles hierboven -->
  <div class="mt-14 border-t border-hog-gold/30 pt-10">
    <h2 class="mb-4 text-2xl font-bold">Full Album</h2>
    <!-- TODO: dit is tijdelijke albuminhoud. Vervang door het echte album
         zodra dat gereleased is. -->
    <SpotifyEmbed
      type="album"
      id="0LRTS7FyYLppkDLOZT02Xp"
      label="Coming soon — full album"
    />
  </div>
</Layout>
